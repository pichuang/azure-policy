{
  "properties": {
    "displayName": "自動為 Network Interface 禁止 IP Forwarding",
    "policyType": "Custom",
    "mode": "All",
    "description": "此原則會自動將網路介面 (NIC) 的 IP Forwarding 設定為停用 (false)，以符合資安規範並防止非預期的流量轉發。",
    "metadata": {
      "category": "Network",
      "version": "1.0.0",
      "defaultNonComplianceMessage": "基於資安考量，所有 NIC 禁止啟用 IP Forwarding。此設定已由 Policy 自動修正為停用。"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "原則效果",
          "description": "啟用或停用此原則的執行"
        },
        "allowedValues": [
          "Modify",
          "Disabled"
        ],
        "defaultValue": "Modify"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Network/networkInterfaces"
          },
          {
            "field": "Microsoft.Network/networkInterfaces/enableIPForwarding",
            "notEquals": false
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "roleDefinitionIds": [
            "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c65974d23b3f"
          ],
          "operations": [
            {
              "operation": "addOrReplace",
              "field": "Microsoft.Network/networkInterfaces/enableIPForwarding",
              "value": false
            }
          ]
        }
      }
    }
  }
}
