{
  "properties": {
    "displayName": "自動將 Azure Key Vault 選擇為 Premium",
    "description": "強制所有新建的 Key Vault 使用 Premium SKU，以支援 HSM (硬體安全模組) 保護的金鑰，符合 NIST 與 FedRAMP 高安全性規範。",
    "mode": "Indexed",
    "metadata": {
      "category": "Security",
      "version": "1.0.0"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "原則效果",
          "description": "啟用或停用此原則的執行"
        },
        "allowedValues": [
          "Modify",
          "Disabled"
        ],
        "defaultValue": "Modify"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.KeyVault/vaults"
          },
          {
            "field": "Microsoft.KeyVault/vaults/sku.name",
            "notEquals": "premium"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "roleDefinitionIds": [
            "/providers/microsoft.authorization/roleDefinitions/f25e0fa2-a7c8-4377-a976-54943a77a395"
          ],
          "operations": [
            {
              "operation": "addOrReplace",
              "field": "Microsoft.KeyVault/vaults/sku.name",
              "value": "premium"
            }
          ]
        }
      }
    }
  }
}
