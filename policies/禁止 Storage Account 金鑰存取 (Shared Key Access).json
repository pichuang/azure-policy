{
  "properties": {
    "displayName": "禁止 Storage Account 允許金鑰存取 (Shared Key Access)",
    "policyType": "Custom",
    "mode": "Indexed",
    "description": "此原則會阻止建立或更新任何將 'allowSharedKeyAccess' 設為 true 的儲存帳戶，強制改用 Entra ID 驗證。",
    "metadata": {
      "category": "Storage",
      "version": "1.0.0"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "原則效果",
          "description": "啟用或停用此原則的執行"
        },
        "allowedValues": [
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Deny"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Storage/storageAccounts"
          },
          {
            "field": "Microsoft.Storage/storageAccounts/allowSharedKeyAccess",
            "notEquals": false
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
