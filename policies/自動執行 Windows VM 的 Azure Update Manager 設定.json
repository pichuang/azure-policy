{
  "properties": {
    "displayName": "自動執行 Windows VM 的 Azure Update Manager 設定",
    "description": "啟用定期評估 (AutomaticByPlatform) 並將修補程式協調設定為平台安全部署 (AutomaticByPlatform)，由 Azure Update Manager 依安全部署流程執行更新。",
    "mode": "Indexed",
    "metadata": {
      "category": "Azure Update Manager",
      "version": "1.0.0"
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Compute/virtualMachines"
          },
          {
            "field": "Microsoft.Compute/imagePublisher",
            "equals": "MicrosoftWindowsServer"
          }
        ]
      },
      "then": {
        "effect": "modify",
        "details": {
          "roleDefinitionIds": [
            "/providers/microsoft.authorization/roleDefinitions/9980e02c-c2be-4d73-94e8-173b1dc7cf3c"
          ],
          "operations": [
            {
              "operation": "addOrReplace",
              "field": "Microsoft.Compute/virtualMachines/osProfile.windowsConfiguration.patchSettings.assessmentMode",
              "value": "AutomaticByPlatform"
            },
            {
              "operation": "addOrReplace",
              "field": "Microsoft.Compute/virtualMachines/osProfile.windowsConfiguration.patchSettings.patchMode",
              "value": "AutomaticByPlatform"
            }
          ]
        }
      }
    }
  }
}