{
  "properties": {
    "displayName": "禁止虛擬機網路介面卡配置公共 IP",
    "description": "強制所有虛擬機只能使用私有 IP，確保內部網路不直接暴露於網際網路。",
    "policyType": "Custom",
    "mode": "Indexed",
    "metadata": {
      "category": "Network",
      "version": "1.0.0",
      "defaultNonComplianceMessage": "虛擬機網路介面卡配置了公共 IP，請移除公共 IP 配置以符合安全要求。"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "原則效果",
          "description": "啟用或停用此原則的執行"
        },
        "allowedValues": [
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Deny"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Network/networkInterfaces"
          },
          {
            "field": "Microsoft.Network/networkInterfaces/ipconfigurations[*].publicIpAddress.id",
            "exists": true
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
