{
  "properties": {
    "displayName": "自動為虛擬網路中的子網路停用預設對外存取能力",
    "description": "建立或更新虛擬網路時，會將其子網路的 defaultOutboundAccess 設為 false。但若虛擬網路中任一子網路已委派給 Microsoft.Sql/managedInstances，則不會套用此修復，避免影響 Azure SQL Managed Instance 的委派需求。",
    "mode": "All",
    "policyType": "Custom",
    "metadata": {
      "category": "Network",
      "version": "1.0.0"
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Network/virtualNetworks"
          },
          {
            "field": "Microsoft.Network/virtualNetworks/subnets[*].defaultOutboundAccess",
            "notEquals": false
          },
          {
            "count": {
              "field": "Microsoft.Network/virtualNetworks/subnets[*]",
              "where": {
                "count": {
                  "field": "Microsoft.Network/virtualNetworks/subnets[*].delegations[*]",
                  "where": {
                    "field": "Microsoft.Network/virtualNetworks/subnets[*].delegations[*].serviceName",
                    "equals": "Microsoft.Sql/managedInstances"
                  }
                },
                "greater": 0
              }
            },
            "equals": 0
          }
        ]
      },
      "then": {
        "effect": "modify",
        "details": {
          "roleDefinitionIds": [
            "/providers/microsoft.authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7"
          ],
          "conflictEffect": "audit",
          "operations": [
            {
              "operation": "addOrReplace",
              "field": "Microsoft.Network/virtualNetworks/subnets[*].defaultOutboundAccess",
              "value": false
            }
          ]
        }
      }
    }
  }
}
