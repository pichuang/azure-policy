{
  "properties": {
    "displayName": "自動為 Network Interface 啟用加速網路 (Accelerated Networking)",
    "policyType": "Custom",
    "mode": "All",
    "description": "此原則會自動將網路介面 (NIC) 的加速網路設定為啟用 (true)，以優化網路延遲與吞吐量。",
    "metadata": {
      "category": "Network",
      "version": "2026.02",
      "defaultNonComplianceMessage": "此環境已自動為您的 NIC 啟用加速網路以優化效能，無需手動配置。"
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Network/networkInterfaces"
          },
          {
            "field": "Microsoft.Network/networkInterfaces/enableAcceleratedNetworking",
            "notEquals": true
          }
        ]
      },
      "then": {
        "effect": "modify",
        "details": {
          "roleDefinitionIds": [
            "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c65974d23b3f"
          ],
          "operations": [
            {
              "operation": "addOrReplace",
              "field": "Microsoft.Network/networkInterfaces/enableAcceleratedNetworking",
              "value": true
            }
          ]
        }
      }
    }
  }
}
