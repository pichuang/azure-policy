{
  "properties": {
    "displayName": "禁止採用 Spot 等級",
    "description": "拒絕所有啟用了 Azure 優先等級為 Spot的虛擬機部署，以確保服務的穩定性與可用性。",
    "policyType": "Custom",
    "mode": "Indexed",
    "metadata": {
      "category": "Compute",
      "version": "1.0.0"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "原則效果",
          "description": "啟用或停用此原則的執行"
        },
        "allowedValues": [
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Deny"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Compute/virtualMachines"
          },
          {
            "field": "Microsoft.Compute/virtualMachines/priority",
            "equals": "Spot"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
