{
  "properties": {
    "displayName": "禁止 Storage Account 匿名存取",
    "policyType": "Custom",
    "mode": "Indexed",
    "description": "此原則會阻止建立或更新任何將 'allowBlobPublicAccess' 設為 true 的儲存帳戶。",
    "parameters": {},
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Storage/storageAccounts"
          },
          {
            "field": "Microsoft.Storage/storageAccounts/allowBlobPublicAccess",
            "notEquals": false
          }
        ]
      },
      "then": {
        "effect": "deny"
      }
    }
  }
}